# Supabase PostgreSQL - Connection via PgBouncer (pooled, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase PostgreSQL - Direct connection (for migrations, port 5432)
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT secret for session tokens (min 32 chars, generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Resend API key for transactional emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public app URL (used for email links, password reset URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
